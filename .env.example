# === Polymarket ===
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_WALLET_ADDRESS=
POLYMARKET_PRIVATE_KEY=

# === Telegram (alerts) ===
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# === Trading Config ===
TRADING_MODE=paper
BANKROLL_USDC=100
MAX_BET_USDC=10
MIN_EDGE_THRESHOLD=0.05
MAX_EXPOSURE_USDC=50
MAX_EDGE=0.20
TAKER_FEE_PCT=0.01
PRICE_CHECK_DELAY_S=60

# === Weather ===
# Free tier: https://openweathermap.org/api (1000 calls/day)
OPENWEATHER_API_KEY=your_api_key
WEATHER_SCAN_INTERVAL=900
MARKET_REFRESH_INTERVAL=300
FORECAST_LOCATIONS=New York,Los Angeles,Chicago,Miami,Washington DC

# === Ensemble Forecast (Open-Meteo — FREE, no key needed) ===
ENSEMBLE_MODEL=gfs_seamless
ENSEMBLE_CACHE_TTL=1800

# === Risk Tuning ===
KELLY_FRACTION=0.25
MAX_POSITION_PCT=0.15
MIN_BOOK_DEPTH_USD=50

# === Database ===
DB_PATH=data/bot.db
